<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\Mods\mod</OutputPath>
    <Nullable>enable</Nullable>
    <RootNamespace>IWantSomeBelts</RootNamespace>
    <AssemblyName>IWantSomeBelts</AssemblyName>
    <!-- Flatpak 1.22.7. Export VINTAGE_STORY to override this if the install moves. -->
    <VINTAGE_STORY Condition="'$(VINTAGE_STORY)' == ''">/var/lib/flatpak/app/at.vintagestory.VintageStory/x86_64/stable/d62c776d061c9e8e6d8148d7665303d3873872ec2d4cec14d2dd2e2ece3b8121/files/extra/vintagestory</VINTAGE_STORY>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="modinfo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="modicon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <ModsFolder Condition="'$(ModsFolder)' == ''">/home/nicolo/.var/app/at.vintagestory.VintageStory/config/VintagestoryData/Mods</ModsFolder>
  </PropertyGroup>

  <Target Name="PackageMod" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)/modinfo.json">
      <Output TaskParameter="Lines" ItemName="ModInfoLine" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <ModInfoText>@(ModInfoLine, ' ')</ModInfoText>
      <ModInfoText>$(ModInfoText.Replace(',', ' '))</ModInfoText>
      <ModId>$([System.Text.RegularExpressions.Regex]::Match($(ModInfoText), '&quot;modid&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups.get_Item(1).Value)</ModId>
      <ModVersion>$([System.Text.RegularExpressions.Regex]::Match($(ModInfoText), '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups.get_Item(1).Value)</ModVersion>
      <StageDir>$(MSBuildProjectDirectory)/bin/$(Configuration)/stage/</StageDir>
      <ModZip>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(ModId)_$(ModVersion).zip</ModZip>
      <ReleaseDir>$(MSBuildProjectDirectory)/Release</ReleaseDir>
    </PropertyGroup>
    <Error Condition="'$(ModId)' == '' Or '$(ModVersion)' == ''" Text="Could not read modid and version from modinfo.json." />

    <RemoveDir Directories="$(StageDir)" />
    <MakeDir Directories="$(StageDir)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).dll;$(TargetDir)modinfo.json;$(TargetDir)modicon.png" DestinationFolder="$(StageDir)" />
    <ItemGroup>
      <ModAsset Include="$(TargetDir)assets/**/*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModAsset)" DestinationFiles="@(ModAsset->'$(StageDir)assets/%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="$(ModZip)" Overwrite="true" />

    <ItemGroup>
      <PreviousZip Include="$(ModsFolder)/$(ModId)_*.zip" />
      <PreviousRelease Include="$(ReleaseDir)/$(ModId)_*.zip" />
    </ItemGroup>
    <Delete Files="@(PreviousZip)" />
    <Copy SourceFiles="$(ModZip)" DestinationFolder="$(ModsFolder)" />
    <MakeDir Directories="$(ReleaseDir)" Condition="'$(Configuration)' == 'Release'" />
    <Delete Files="@(PreviousRelease)" Condition="'$(Configuration)' == 'Release'" />
    <Copy SourceFiles="$(ModZip)" DestinationFolder="$(ReleaseDir)" Condition="'$(Configuration)' == 'Release'" />
    <Message Importance="high" Text="Installed $(ModId)_$(ModVersion).zip into $(ModsFolder)" />
  </Target>

</Project>
